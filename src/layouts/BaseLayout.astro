---
/**
 * BaseLayout.astro
 * Gita Press Gorakhpur Sacred Paper Book Layout Shell
 */
import '../styles/global.css';
import SEO from '../components/SEO.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  author?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  author,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="hi" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#8e1b14" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- SEO Component -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      author={author}
      jsonLd={jsonLd}
    />
  </head>

  <body>
    <!-- Site Header -->
    <header class="site-header" role="banner">
      <div class="container">
        <a href="/" class="site-logo" aria-label="ज्ञानकोश मुख्य पृष्ठ">
          <span class="logo-mark" aria-hidden="true">ज्ञ</span>
          <span>ज्ञानकोश</span>
        </a>

        <nav role="navigation" aria-label="मुख्य अनुभाग">
          <ul style="display:flex; gap:1.25rem; list-style:none; align-items:center;">
            <li><a href="/category/veda" style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">वेद</a></li>
            <li><a href="/category/gita" style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">गीता</a></li>
            <li><a href="/category/chalisa" style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">चालीसा</a></li>
            <li><a href="/category/purana" style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">पुराण</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <!-- Page Content -->
    <main id="main-content" role="main">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer
      role="contentinfo"
      style="padding:2.5rem 1rem;text-align:center;font-family:var(--font-devanagari);font-size:0.9rem;color:var(--color-text-muted);border-top:2px solid var(--color-border);margin-top:3rem;background:var(--color-bg-elevated);"
    >
      <p style="color:var(--color-accent);font-weight:700;margin-bottom:0.25rem;">॥ श्रीहरिः ॥</p>
      <p>ज्ञानकोश — सनातन वैदिक एवं पौराणिक धर्मग्रंथों का डिजिटल संग्रह</p>
    </footer>
  </body>
</html>
